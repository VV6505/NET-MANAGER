<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>QLQUANNET</display-name>

    <filter>
        <filter-name>Utf8Filter</filter-name>
        <filter-class>com.netgamer.qlquannet.filter.Utf8Filter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>Utf8Filter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- DB config (fallback to env var if not set) -->
    <context-param>
        <param-name>DB_URL</param-name>
        <param-value>jdbc:sqlserver://localhost:1433;databaseName=dbNET;encrypt=true;trustServerCertificate=true;integratedSecurity=false</param-value>
    </context-param>
    <context-param>
        <param-name>DB_USERNAME</param-name>
        <param-value>sa</param-value>
    </context-param>
    <context-param>
        <param-name>DB_PASSWORD</param-name>
        <param-value>123456</param-value>
    </context-param>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>PlaceholderImageServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.PlaceholderImageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlaceholderImageServlet</servlet-name>
        <url-pattern>/img/placeholder</url-pattern>
    </servlet-mapping>

    <!-- CLIENT -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClientAuthServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.ClientAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClientAuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ClientAuthServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ClientAuthServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OpenAppServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.OpenAppServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OpenAppServlet</servlet-name>
        <url-pattern>/open-app</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HistoryServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.HistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HistoryServlet</servlet-name>
        <url-pattern>/history</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClientPaidInvoicesExportServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.ClientPaidInvoicesExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClientPaidInvoicesExportServlet</servlet-name>
        <url-pattern>/history/export</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InvoiceExportServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.client.InvoiceExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InvoiceExportServlet</servlet-name>
        <url-pattern>/invoice</url-pattern>
    </servlet-mapping>

    <!-- STAFF -->
    <servlet>
        <servlet-name>StaffAuthServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.StaffAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffAuthServlet</servlet-name>
        <url-pattern>/staff/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffAuthServlet</servlet-name>
        <url-pattern>/staff/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffHomeServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.StaffHomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffHomeServlet</servlet-name>
        <url-pattern>/staff</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffHomeServlet</servlet-name>
        <url-pattern>/staff/</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffRoomsServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.StaffRoomsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffRoomsServlet</servlet-name>
        <url-pattern>/staff/rooms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffComputersServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.StaffComputersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffComputersServlet</servlet-name>
        <url-pattern>/staff/computers</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffComputersServlet</servlet-name>
        <url-pattern>/staff/computers/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffCustomersServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.StaffCustomersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffCustomersServlet</servlet-name>
        <url-pattern>/staff/customers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffInvoicesServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.StaffInvoicesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffInvoicesServlet</servlet-name>
        <url-pattern>/staff/invoices</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffEmployeesServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.StaffEmployeesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffEmployeesServlet</servlet-name>
        <url-pattern>/staff/employees</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffEmployeesServlet</servlet-name>
        <url-pattern>/staff/employees/*</url-pattern>
    </servlet-mapping>

    <!-- Báo cáo doanh thu: ThongKeServlet + xuất Excel (POI) / PDF (iText) -->
    <servlet>
        <servlet-name>ThongKeServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.ThongKeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ThongKeServlet</servlet-name>
        <url-pattern>/staff/revenue</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ExportExcelServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.ExportExcelServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExportExcelServlet</servlet-name>
        <url-pattern>/staff/revenue/export/excel</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ExportPDFServlet</servlet-name>
        <servlet-class>com.netgamer.qlquannet.servlet.staff.ExportPDFServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExportPDFServlet</servlet-name>
        <url-pattern>/staff/revenue/export/pdf</url-pattern>
    </servlet-mapping>

</web-app>

